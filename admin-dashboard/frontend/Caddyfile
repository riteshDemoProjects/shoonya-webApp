# Serves the admin SPA and forwards /admin/* to the admin API.
#
# The admin API owns the /admin/* URL space, so the SPA is published on its own
# port (see docker-compose.yml) rather than under a /admin path — that keeps the
# API prefix free and needs no Vite base or router basename changes.
:80 {
	encode gzip zstd

	# Must come before the file_server block: these are API routes, not files.
	handle /admin/* {
		reverse_proxy admin-api:8000
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
