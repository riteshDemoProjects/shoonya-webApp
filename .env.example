# Copy to .env on the VM and fill in. Never commit the filled-in .env.
#
#   cp .env.example .env

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the connection-pooler URI (port 6543) rather than the direct 5432 one:
# the pooler tolerates many short-lived connections far better.
# The backends rewrite the scheme to postgresql+psycopg:// automatically.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Two independent signing keys. Generate each with:
#   openssl rand -hex 32
WEB_SECRET_KEY=
ADMIN_SECRET_KEY=
